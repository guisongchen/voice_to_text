[Unit]
Description=Voice-to-Text Web Dashboard
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/projects/voice_to_text/.venv/bin/python3 -m voice_to_text.dashboard
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
